<script>
(function(){
document.body.classList.add('js');
/* reveal-поллинг */
var done=false;
function scan(){
  if(done)return;
  var els=document.querySelectorAll('.reveal:not(.in)');
  var vh=window.innerHeight||800;
  for(var i=0;i<els.length;i++){
    var r=els[i].getBoundingClientRect();
    if(r.top<vh-40&&r.bottom>0)els[i].classList.add('in');
  }
  if(!els.length)done=true;
}
setInterval(scan,400);scan();
/* === M4: драг алмазного бурения === */
var H=360; /* слайдер 0..360 = глубина мм *1 (бетон 360мм) */
var hole=document.getElementById('hole'),crown=document.getElementById('crown'),
    mm=document.getElementById('mm'),deep=document.getElementById('ddeep'),
    st=document.getElementById('dstate'),spark=document.getElementById('spark'),
    bars=document.querySelectorAll('#bars rect'),sl=document.getElementById('dslider');
if(sl&&hole){
  function render(q){
    q=Math.max(0,Math.min(1,q));
    var d=q*360;
    hole.setAttribute('height',Math.max(0,d-40>0?d:0));
    /* коронка едет вниз до 80+360=440 */
    var cy=34+q*(360+6);
    crown.setAttribute('transform','translate(0,'+(cy-34)+')');
    mm.textContent=Math.round(d)+' мм';
    deep.textContent=Math.round(d)+' мм';
    var state,note;
    if(d<5){state='Коронка на старте. Алмазные сегменты охлаждаются водой — пыли и ударов нет.';note='Тяните ползунок: коронка проходит бетон и режет арматуру без трещин в конструкции.';spark.setAttribute('opacity','0')}
    else if(d<200){state='Проходка бетона. Без ударных нагрузок — конструкция не получает трещин.';note='Коронка охлаждается водой: резка идёт ровно, без пыли и вибрации.';spark.setAttribute('opacity','1')}
    else if(d<260){state='Рез арматуры: коронка встретила стержень и режет его тем же проходом.';note='Арматура не «выбивается» — алмазные сегменты проходят её без ослабления фундамента.';spark.setAttribute('opacity','1')}
    else if(d<355){state='Финальный слой бетона. Отверстие получается с ровными краями.';note='Готовый проём не требует дополнительной обработки под ввод трубы.';spark.setAttribute('opacity','1')}
    else{state='Сквозной проём готов: ровные края, без трещин, конструкция сохраняет прочность.';note='Так выглядит ввод канализации в фундамент — можно ставить гильзу и трубу.';spark.setAttribute('opacity','0')}
    st.textContent=state;
    /* арматура разрезается по проходу */
    for(var k=0;k<bars.length;k++){
      var b=bars[k],by=parseFloat(b.getAttribute('y'));
      var cut=(d>=(by-80+40));
      b.setAttribute('opacity',cut?'.25':'.8');
      var b2=document.getElementById('cut'+k);
      if(!b2&&cut){
        b2=document.createElementNS('http://www.w3.org/2000/svg','rect');
        b2.setAttribute('id','cut'+k);b2.setAttribute('x',b.getAttribute('x'));
        b2.setAttribute('y',by);b2.setAttribute('width',b.getAttribute('width'));
        b2.setAttribute('height','10');b2.setAttribute('fill','#DDE5E2');
        b.parentNode.insertBefore(b2,b.nextSibling);
      }
    }
  }
  sl.addEventListener('input',function(){render(sl.value/H)});
  /* автопрогон при попадании в кадр */
  var seen=false;
  setInterval(function(){
    var r=document.getElementById('dsvg').getBoundingClientRect();
    if(!seen&&r.top<(window.innerHeight||800)&&r.bottom>0){
      seen=true;
      var t0=Date.now();
      var iv=setInterval(function(){
        var q=(Date.now()-t0)/3200;
        if(q>=1){render(1);sl.value=H;clearInterval(iv);return}
        render(q);sl.value=Math.round(q*H);
      },40);
    }
  },400);
  render(0);
  window.__wow={render:function(q){render(q);if(sl)sl.value=Math.round(Math.max(0,Math.min(1,q))*H);return true}};
}
/* форма: крупный телефон в футере */
var f=document.getElementById('zform');
if(f)f.addEventListener('submit',function(e){
  e.preventDefault();
  var t=document.getElementById('ztel');
  if(!t.value.trim()||t.value.replace(/\D/g,'').length<9){t.style.borderColor='#C73A28';return}
  t.style.borderColor='';
  document.getElementById('zok').style.display='block';
  f.reset();
});
})();
</script>
</body>
</html>
