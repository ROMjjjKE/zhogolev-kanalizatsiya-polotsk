input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;height:32px;width:32px;border-radius:50%;background:var(--acc);border:4px solid #fff;box-shadow:0 2px 8px rgba(70,160,130,.45);margin-top:-15px}
